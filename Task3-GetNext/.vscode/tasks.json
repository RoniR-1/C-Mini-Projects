{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "build get_next_line",
      "command": "gcc",
      "args": [
        "-g",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-D",
        "BUFFER_SIZE=10000000",
        "get_next_line.c",
        "get_next_line_utils.c",
        "main.c",
        "-o",
        "${workspaceFolder}/getNext"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}